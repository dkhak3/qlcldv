rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

      function isEditor() {
        return signedIn()
          && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
      }
      function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
      function isSuperAdmin() { return signedIn() && request.auth.token.role == 'superadmin'; }
      function canEditComment(commentData) {
        return signedIn() && (
          commentData.ownerId == request.auth.uid
          || (isAdmin() && commentData.ownerRole == 'user')
        );
      }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

      match /blog_posts/{postId} {
        allow read: if signedIn() && (resource.data.status == 'published' || isEditor());
      allow create, delete: if isEditor();
      allow update: if isEditor()
        || (
            signedIn()
            && resource.data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1
        );
    }

      match /report_boxes/{boxId} {
        allow read: if signedIn();
        allow create: if isEditor();
        allow update: if isEditor()
          && request.resource.data.key == resource.data.key;
        allow delete: if isEditor()
          && !(boxId in ['camera', 'gps', 'txdl', 'speed-4h', 'gstt', 'hau-kiem'])
          && !(resource.data.key in ['camera', 'gps', 'txdl', 'speed-4h', 'gstt', 'hau-kiem']);
      }

      match /blog_categories/{categoryId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /blog_post_likes/{likeId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
        allow update: if false;
      }

      match /blog_bookmarks/{bookmarkId} {
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow read: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow delete: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow update: if false;
      }

      match /blog_comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow update: if signedIn()
          && canEditComment(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt', 'lastEditId'])
          && request.resource.data.content != resource.data.content
          && request.resource.data.lastEditId is string
          && existsAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId))
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.commentId == commentId
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.beforeContent == resource.data.content
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.afterContent == request.resource.data.content
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.editorId == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || (isAdmin() && resource.data.ownerRole == 'user')
          || (isSuperAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
      }

      match /blog_comment_edits/{editId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.editorId == request.auth.uid
          && request.resource.data.editorRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId))
          && canEditComment(get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data)
          && request.resource.data.commentOwnerId == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.ownerId
          && request.resource.data.commentOwnerRole == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.ownerRole
          && request.resource.data.postId == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.postId
          && request.resource.data.beforeContent == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.content
          && request.resource.data.afterContent == getAfter(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.content
          && getAfter(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.lastEditId == editId;
        allow update, delete: if false;
      }

      match /blog_comment_reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow update: if signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.commentId == resource.data.commentId
          && request.resource.data.postId == resource.data.postId;
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }

      match /donation_accounts/{accountId} {
        allow read: if signedIn();
        allow create, update, delete: if isSuperAdmin();
      }

      match /donation_settings/{settingId} {
        allow read: if signedIn();
        allow create, update: if isSuperAdmin();
        allow delete: if false;
      }

      match /top_donates/{donateId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /site_pages/{pageId} {
        allow read: if signedIn();
        allow create, update, delete: if isSuperAdmin();
      }

      match /saved_reports/{reportId} {
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow read: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow delete: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || (isSuperAdmin() && resource.data.ownerRole != 'superadmin')
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow update: if false;
      }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
