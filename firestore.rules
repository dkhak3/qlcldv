rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

      function isEditor() {
        return signedIn()
          && (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
      }
      function isAdmin() { return signedIn() && request.auth.token.role == 'admin'; }
      function isSuperAdmin() { return signedIn() && request.auth.token.role == 'superadmin'; }
      function canEditComment(commentData) {
        return signedIn() && (
          commentData.ownerId == request.auth.uid
          || (isAdmin() && commentData.ownerRole == 'user')
        );
      }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

      match /blog_posts/{postId} {
        allow read: if signedIn() && (resource.data.status == 'published' || isEditor());
      allow create: if isEditor();
      // Xóa bài viết phải đi qua API quản trị để xóa dây chuyền dữ liệu liên quan.
      allow delete: if false;
      allow update: if isEditor()
        || (
            signedIn()
            && resource.data.status == 'published'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.views + 1
        );
    }

      match /report_boxes/{boxId} {
        allow read: if signedIn();
        allow create: if isEditor();
        allow update: if isEditor()
          && request.resource.data.key == resource.data.key;
        allow delete: if isEditor()
          && !(boxId in ['camera', 'gps', 'txdl', 'speed-4h', 'gstt', 'hau-kiem'])
          && !(resource.data.key in ['camera', 'gps', 'txdl', 'speed-4h', 'gstt', 'hau-kiem']);
      }

      match /blog_categories/{categoryId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /blog_post_likes/{likeId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_posts/$(request.resource.data.postId));
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
        allow update: if false;
      }

      match /blog_bookmarks/{bookmarkId} {
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_posts/$(request.resource.data.postId));
        allow read: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow delete: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow update: if false;
      }

      match /blog_comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_posts/$(request.resource.data.postId));
        allow update: if signedIn()
          && canEditComment(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'updatedAt', 'lastEditId'])
          && request.resource.data.content != resource.data.content
          && request.resource.data.lastEditId is string
          && existsAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId))
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.commentId == commentId
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.beforeContent == resource.data.content
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.afterContent == request.resource.data.content
          && getAfter(/databases/$(database)/documents/blog_comment_edits/$(request.resource.data.lastEditId)).data.editorId == request.auth.uid;
        // Xóa bình luận phải đi qua API quản trị để xóa cả lịch sử và cảm xúc.
        allow delete: if false;
      }

      match /blog_comment_edits/{editId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.editorId == request.auth.uid
          && request.resource.data.editorRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId))
          && canEditComment(get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data)
          && request.resource.data.commentOwnerId == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.ownerId
          && request.resource.data.commentOwnerRole == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.ownerRole
          && request.resource.data.postId == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.postId
          && request.resource.data.beforeContent == get(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.content
          && request.resource.data.afterContent == getAfter(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.content
          && getAfter(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId)).data.lastEditId == editId;
        allow update, delete: if false;
      }

      match /blog_comment_reactions/{reactionId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role
          && exists(/databases/$(database)/documents/blog_posts/$(request.resource.data.postId))
          && exists(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId));
        allow update: if signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.commentId == resource.data.commentId
          && request.resource.data.postId == resource.data.postId
          && exists(/databases/$(database)/documents/blog_posts/$(request.resource.data.postId))
          && exists(/databases/$(database)/documents/blog_comments/$(request.resource.data.commentId));
        allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
      }

      match /donation_accounts/{accountId} {
        allow read: if signedIn();
        allow create, update, delete: if isSuperAdmin();
      }

      match /donation_settings/{settingId} {
        allow read: if signedIn();
        allow create, update: if isSuperAdmin();
        allow delete: if false;
      }

      match /top_donates/{donateId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /site_pages/{pageId} {
        allow read: if signedIn();
        allow create, update, delete: if isSuperAdmin();
      }

      match /route_sheets/{sheetId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /route_workbooks/{workbookId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /route_workbook_chunks/{chunkId} {
        allow read: if signedIn();
        allow create, update, delete: if isEditor();
      }

      match /report_templates/{templateId} {
        allow read: if signedIn();
        allow create, update: if isSuperAdmin();
        allow delete: if false;
      }

      match /report_template_versions/{versionId} {
        allow read: if isSuperAdmin();
        allow create: if isSuperAdmin();
        allow update, delete: if false;
      }

      match /audit_logs/{logId} {
        allow read: if isSuperAdmin();
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.actorRole == request.auth.token.role;
        allow update, delete: if false;
      }

      match /haukiem_daily_reports/{reportId} {
        function reportMetadataPath() {
          return /databases/$(database)/documents/haukiem_daily_reports/current;
        }

        function reportFilePath() {
          return /databases/$(database)/documents/haukiem_daily_reports/current_file;
        }

        function reportMetadataIsVisible() {
          return exists(reportMetadataPath())
            && get(reportMetadataPath()).data.storageType == 'firestore'
            && get(reportMetadataPath()).data.isVisible == true;
        }

        function validReportMetadata() {
          return request.resource.data.keys().hasAll([
              'storageType', 'originalName', 'contentType', 'size', 'isVisible',
              'updatedAt', 'updatedBy', 'updatedByName', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'storageType', 'originalName', 'contentType', 'size', 'isVisible',
              'updatedAt', 'updatedBy', 'updatedByName', 'createdAt'
            ])
            && request.resource.data.storageType == 'firestore'
            && request.resource.data.originalName is string
            && request.resource.data.contentType is string
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 500 * 1024
            && request.resource.data.isVisible is bool
            && request.resource.data.updatedBy is string
            && request.resource.data.updatedByName is string
            && existsAfter(reportFilePath())
            && getAfter(reportFilePath()).data.fileData is bytes
            && getAfter(reportFilePath()).data.fileData.size() == request.resource.data.size
            && getAfter(reportFilePath()).data.originalName == request.resource.data.originalName
            && getAfter(reportFilePath()).data.contentType == request.resource.data.contentType;
        }

        function validReportFile() {
          return request.resource.data.keys().hasAll([
              'fileData', 'originalName', 'contentType', 'size', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'fileData', 'originalName', 'contentType', 'size', 'updatedAt'
            ])
            && request.resource.data.fileData is bytes
            && request.resource.data.fileData.size() > 0
            && request.resource.data.fileData.size() <= 500 * 1024
            && request.resource.data.size is int
            && request.resource.data.size == request.resource.data.fileData.size()
            && request.resource.data.originalName is string
            && request.resource.data.contentType is string
            && existsAfter(reportMetadataPath())
            && getAfter(reportMetadataPath()).data.storageType == 'firestore'
            && getAfter(reportMetadataPath()).data.size == request.resource.data.size
            && getAfter(reportMetadataPath()).data.originalName == request.resource.data.originalName
            && getAfter(reportMetadataPath()).data.contentType == request.resource.data.contentType;
        }

        allow get: if signedIn() && (
          reportId == 'current'
          || (reportId == 'current_file' && (isSuperAdmin() || reportMetadataIsVisible()))
        );
        allow list: if false;
        allow create, update: if isSuperAdmin() && (
          (reportId == 'current' && validReportMetadata())
          || (reportId == 'current_file' && validReportFile())
        );
        allow delete: if isSuperAdmin() && (
          (reportId == 'current' && !existsAfter(reportFilePath()))
          || (reportId == 'current_file' && !existsAfter(reportMetadataPath()))
        );
      }

      match /saved_reports/{reportId} {
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerRole == request.auth.token.role;
        allow read: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || isSuperAdmin()
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow delete: if signedIn() && (
          resource.data.ownerId == request.auth.uid
          || (isSuperAdmin() && resource.data.ownerRole != 'superadmin')
          || (isAdmin() && (resource.data.ownerRole == 'user' || resource.data.ownerRole == 'admin'))
        );
        allow update: if false;
      }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
